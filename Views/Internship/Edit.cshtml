@model InternshipPortal.Models.Internship

<div class="container mt-5">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow p-4 border-0">
            <h2 class="fw-bold mb-4">Edit Internship</h2>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="InternshipId" />
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Job Title</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Required Skills (Comma separated)</label>
                    <input asp-for="RequiredSkills" class="form-control" required />
                    <small class="text-muted">Example: C#, SQL, React</small>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Save Changes</button>
                    <a asp-action="Index" class="btn btn-light w-100 rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>