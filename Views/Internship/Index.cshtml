@model IEnumerable<InternshipPortal.Models.Internship>

<div class="container mt-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-briefcase-fill text-primary"></i> Internship Management</h2>
            <p class="text-muted">View, edit, or remove your active internship postings.</p>
        </div>
        @if (User.IsInRole("Recruiter")) {
            <a href="/Internship/Create" class="btn btn-primary btn-lg shadow-sm rounded-pill">
                <i class="bi bi-plus-lg"></i> Post New Internship
            </a>
        }
    </div>
    <hr />

    <!-- Job Cards -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-folder2-open display-1 text-muted"></i>
                <p class="mt-3 fs-5 text-muted">No internships posted yet.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model) {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@item.Title</h5>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Active</span>
                            </div>
                            <h6 class="text-secondary mb-3"><i class="bi bi-building"></i> @item.CompanyName</h6>
                            
                            <p class="text-muted small mb-2"><strong>Required Skills:</strong></p>
                            <div class="mb-4">
                                @foreach (var skill in item.RequiredSkills.Split(','))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border me-1 mb-1" style="font-size: 0.75rem;">
                                        @skill.Trim()
                                    </span>
                                }
                            </div>

                            <!-- ACTION BUTTONS -->
                            <div class="d-flex gap-2 mt-auto border-top pt-3">
                                @if (User.IsInRole("Recruiter")) 
                                {
                                    <a asp-action="Edit" asp-route-id="@item.InternshipId" class="btn btn-sm btn-outline-primary flex-grow-1 rounded-pill">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.InternshipId" method="post" class="flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this internship? This cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else 
                                {
                                    <a href="#" class="btn btn-primary w-100 rounded-pill">Details</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .transition {
        transition: all 0.3s ease;
    }
    .bg-primary-subtle { background-color: #e7f1ff; }
</style>