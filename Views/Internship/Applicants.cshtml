@model IEnumerable<dynamic>

<div class="container mt-5 pb-5">
    <!-- HEADER SECTION -->
    <div class="row mb-4 align-items-end">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark"><i class="bi bi-person-check-fill text-primary"></i> Recruitment Dashboard</h2>
            <p class="text-muted">Review applications, view student resumes, and track your hiring pipeline.</p>
        </div>
        <div class="col-md-4 text-center">
            <!-- MINI DOUGHNUT CHART -->
            <div style="width: 120px; height: 120px; margin: 0 auto;">
                <canvas id="talentChart"></canvas>
            </div>
            <p class="small fw-semibold mt-1 mb-0">Talent Distribution</p>
        </div>
    </div>

    <!-- ANALYTICS CARDS SECTION -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 h-100 border-start border-primary border-5">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">Total Applicants</h6>
                        <h2 class="mb-0 fw-bold">@Model.Count()</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 h-100 border-start border-success border-5">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">Successfully Hired</h6>
                        <h2 class="mb-0 fw-bold">@Model.Count(x => x.Status == "Accepted")</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-check-all fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 h-100 border-start border-info border-5">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">High Match (>70%)</h6>
                        <h2 class="mb-0 fw-bold">@Model.Count(x => x.Score >= 70)</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                        <i class="bi bi-lightning-charge fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DETAILED APPLICATIONS TABLE -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-list-ul me-2"></i>Recent Applications</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 text-uppercase">Student Information</th>
                        <th class="text-uppercase">Job Posting</th>
                        <th class="text-uppercase">Resume / CV</th>
                        <th class="text-uppercase text-center">Match Quality</th>
                        <th class="text-uppercase">Hiring Status</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-placeholder me-3">
                                        <i class="bi bi-person-circle fs-3 text-secondary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@app.StudentName</div>
                                        <small class="text-muted">Student Applicant</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-medium px-3 py-2">@app.JobTitle</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(app.ResumePath))
                                {
                                    <a href="/resumes/@app.ResumePath" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-file-earmark-pdf-fill"></i> View PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small italic">No Resume</span>
                                }
                            </td>
                            <td style="width: 200px;">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="progress flex-grow-1 me-3" style="height: 8px; border-radius: 10px; min-width: 100px;">
                                        <div class="progress-bar @(app.Score >= 70 ? "bg-success" : (app.Score >= 40 ? "bg-warning" : "bg-danger"))" 
                                             role="progressbar" 
                                             style="width: @app.Score%" 
                                             aria-valuenow="@app.Score" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <span class="fw-bold @(app.Score >= 70 ? "text-success" : "text-dark")">@app.Score%</span>
                                </div>
                            </td>
                            <td>
                                @if(app.Status == "Pending") 
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="appId" value="@app.ApplicationId" />
                                        <button name="status" value="Accepted" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                            <i class="bi bi-check-lg"></i> Hire
                                        </button>
                                        <button name="status" value="Rejected" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Pass
                                        </button>
                                    </form>
                                } 
                                else 
                                {
                                    <span class="badge @(app.Status == "Accepted" ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") rounded-pill px-4 py-2">
                                        <i class="bi @(app.Status == "Accepted" ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i> @app.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PROFESSIONAL CHART LOGIC -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById('talentChart').getContext('2d');
        
        var highMatchCount = @Model.Count(x => x.Score >= 70);
        var othersCount = @Model.Count(x => x.Score < 70);

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['High Match', 'Other'],
                datasets: [{
                    data: [highMatchCount, othersCount],
                    backgroundColor: ['#0d6efd', '#e9ecef'],
                    borderWidth: 0,
                    hoverOffset: 2
                }]
            },
            options: {
                cutout: '80%',
                plugins: {
                    legend: { display: false },
                    tooltip: { enabled: true }
                }
            }
        });
    });
</script>

<style>
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-danger-subtle { background-color: #f8d7da; }
    .table thead th { font-weight: 600; letter-spacing: 0.5px; }
    .avatar-placeholder { opacity: 0.6; }
</style>