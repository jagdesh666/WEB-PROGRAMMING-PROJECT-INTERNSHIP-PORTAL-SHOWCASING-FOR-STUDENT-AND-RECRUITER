@model InternshipPortal.Models.User

<div class="container mt-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Branding Header -->
                <div class="card-header bg-primary py-4 text-white text-center border-0">
                    <i class="bi bi-rocket-takeoff fs-1"></i>
                    <h2 class="fw-bold mb-0">Join InternshipPortal</h2>
                    <p class="mb-0 opacity-75">Create your account to get started</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    
                    <!-- ALERT FOR DUPLICATE EMAIL ERROR -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 rounded-3">
                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                            <div>
                                <strong>Registration Failed:</strong> @ViewBag.Error
                            </div>
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-person me-1"></i> Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg bg-light border-0 shadow-sm" placeholder="Enter your full name" required />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-envelope me-1"></i> Email Address</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg bg-light border-0 shadow-sm" placeholder="name@example.com" required />
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-lock me-1"></i> Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg bg-light border-0 shadow-sm" placeholder="Create a secure password" required />
                        </div>

                        <!-- Role Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="bi bi-person-badge me-1"></i> I am a...</label>
                            <select asp-for="Role" class="form-select form-select-lg bg-light border-0 shadow-sm" required>
                                <option value="Student">Student (Looking for Internships)</option>
                                <option value="Recruiter">Recruiter (Posting Internships)</option>
                            </select>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-bold py-3">
                                Create My Account <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="text-muted">Already have an account? <a href="/Account/Login" class="fw-bold text-primary text-decoration-none">Login here</a></p>
                    </div>
                </div>
            </div>

            <!-- Trust Footer -->
            <div class="text-center mt-4 opacity-50">
                <small><i class="bi bi-shield-check"></i> Your data is secured with Industry Standard BCrypt Encryption</small>
            </div>
        </div>
    </div>
</div>

<style>
    /* Focus effects for modern look */
    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
    .card {
        transition: transform 0.3s ease;
    }
</style>