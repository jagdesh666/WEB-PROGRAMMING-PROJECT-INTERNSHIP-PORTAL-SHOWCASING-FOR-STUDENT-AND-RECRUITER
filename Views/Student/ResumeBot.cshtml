<div class="container-fluid mt-3 pb-5">
    <div class="row g-4">
        <!-- LEFT: THE AI CHATBOT -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 rounded-4" style="height: 80vh;">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0"><i class="bi bi-robot"></i> Resume Assistant</h5>
                    <small>Conversational AI Builder</small>
                </div>
                <div id="chat-box" class="card-body overflow-auto p-3 bg-light">
                    <div class="bot-bubble p-3 mb-3 shadow-sm bg-white">
                        Hello! I'm your AI Resume Assistant. I'll help you build a professional CV. 
                        Let's start with your **Full Name** and **Contact Details**.
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-3">
                    <div class="input-group">
                        <input type="text" id="user-input" class="form-control border-2" placeholder="Type your details...">
                        <button class="btn btn-primary" onclick="handleChat()"><i class="bi bi-send"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: THE RESUME PREVIEW (Live Rendering) -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4" style="height: 80vh;">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-person"></i> Professional Preview</h5>
                    <button class="btn btn-success btn-sm rounded-pill px-3" onclick="downloadResume()">
                        <i class="bi bi-download"></i> Download PDF
                    </button>
                </div>
                <div class="card-body overflow-auto bg-secondary bg-opacity-10 p-5">
                    <!-- This is the actual "Paper" -->
                    <div id="resume-paper" class="bg-white shadow-lg mx-auto p-5" style="width: 210mm; min-height: 297mm; font-family: 'serif';">
                        <div id="resume-content">
                            <h2 class="text-center text-muted">Your Resume Will Appear Here</h2>
                            <p class="text-center mt-4">Start chatting with the AI to generate content...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    .bot-bubble { border-radius: 15px 15px 15px 2px; border-left: 4px solid #0d6efd; font-size: 0.9rem; }
    .user-bubble { border-radius: 15px 15px 2px 15px; font-size: 0.9rem; margin-left: auto; }
    #resume-paper h1, #resume-paper h2, #resume-paper h3 { border-bottom: 1px solid #eee; padding-bottom: 5px; margin-top: 20px; }
    #resume-paper ul { padding-left: 20px; }
</style>

<script>
    // Context Retention: We store the history in a JS Array
    let chatHistory = [
        { role: "model", parts: [{ text: "Hello! I'm your AI Resume Assistant. I'll help you build a professional CV. Let's start with your Full Name and Contact Details." }] }
    ];

    document.getElementById('user-input').addEventListener('keypress', e => { if(e.key === 'Enter') handleChat(); });

    async function handleChat() {
    const input = document.getElementById('user-input');
    const message = input.value.trim();
    if(!message) return;

    addMessage(message, 'user');
    input.value = '';

    const typingId = "typing-" + Date.now();
    addMessage("Ollama is thinking...", 'bot', typingId);

    try {
        const response = await fetch('/Student/BuildResumeAI', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                history: JSON.stringify(chatHistory), 
                message: message 
            })
        });

        const data = await response.json();
        document.getElementById(typingId).remove();

        const aiReply = data.reply;
        
        // Update History (Keeping the internal format consistent)
        chatHistory.push({ role: "user", parts: [{ text: message }] });
        chatHistory.push({ role: "model", parts: [{ text: aiReply }] });

        // Update the Resume Preview
        const resumeMatch = aiReply.match(/\[RESUME_START\]([\s\S]*?)\[RESUME_END\]/);
        if (resumeMatch) {
            document.getElementById('resume-content').innerHTML = resumeMatch[1];
            const cleanText = aiReply.replace(/\[RESUME_START\][\s\S]*?\[RESUME_END\]/, "").trim();
            addMessage(cleanText || "I've updated your resume preview.", 'bot');
        } else {
            addMessage(aiReply, 'bot');
        }

    } catch (err) {
        document.getElementById(typingId).innerText = "Error: Is Ollama running?";
    }
}

    function addMessage(text, sender, id = null) {
    const box = document.getElementById('chat-box');
    const div = document.createElement('div');
    // Styling
    div.className = sender === 'bot' ? 'bot-bubble p-3 mb-3 bg-white shadow-sm' : 'user-bubble p-3 mb-3 bg-primary text-white shadow-sm w-75';
    if(id) div.id = id;

    // This converts **Text** to <strong>Text</strong> and new lines to <br>
    let formattedText = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    formattedText = formattedText.replace(/\n/g, '<br>');
    
    div.innerHTML = formattedText;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
}

    function downloadResume() {
        const element = document.getElementById('resume-paper');
        html2pdf().from(element).set({ margin: 0.5, filename: 'Resume.pdf', jsPDF: { format: 'a4', orientation: 'portrait' } }).save();
    }
</script>