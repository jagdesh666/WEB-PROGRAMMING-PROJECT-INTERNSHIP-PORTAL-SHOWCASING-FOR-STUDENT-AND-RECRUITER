@model IEnumerable<dynamic>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center">
        <h2>My Application History</h2>
        <a href="/Student/Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't applied for any internships yet. <a href="/Student/Index">Start applying now!</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var app in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-left-primary">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="mb-0 text-primary">@app.JobTitle</h5>
                                    <p class="text-muted mb-2">@app.CompanyName</p>
                                    <div class="small">
                                        <strong>Match Score:</strong> @app.Score%
                                    </div>
                                </div>
                                <div class="col-auto text-center">
                                    <!-- Dynamic status badges -->
                                    @if (app.Status == "Accepted")
                                    {
                                        <span class="badge bg-success p-2">🎉 Accepted</span>
                                        <p class="small text-success mt-1">Check your email!</p>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger p-2">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark p-2">Pending Review</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .border-left-primary {
        border-left: 5px solid #0d6efd;
    }
</style>